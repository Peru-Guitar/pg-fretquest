rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Perfil privado: cada usuario solo lee y escribe el suyo (nombre, ciudad, país, guitarra, nivel, ritmo, sesión, última práctica).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'level', 'city', 'country', 'guitar', 'weeklyGoal', 'sessionMinutes', 'lastPractice'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40))
        && (!('level' in request.resource.data) || (request.resource.data.level in ['base', 'intermedio', 'avanzado', 'experto']))
        && (!('weeklyGoal' in request.resource.data) || (request.resource.data.weeklyGoal is int && request.resource.data.weeklyGoal >= 2 && request.resource.data.weeklyGoal <= 6))
        && (!('sessionMinutes' in request.resource.data) || (request.resource.data.sessionMinutes in [15, 30, 45]))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 60))
        && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 60))
        && (!('guitar' in request.resource.data) || (request.resource.data.guitar is string && request.resource.data.guitar.size() <= 60))
        && (!('lastPractice' in request.resource.data) || (request.resource.data.lastPractice.keys().hasOnly(['lessonId', 'date'])
            && request.resource.data.lastPractice.lessonId is string && request.resource.data.lastPractice.date is string));

      // Registro del día. Lo escribe solo su dueño; el id es la fecha y no se puede borrar.
      // El tiempo solo sube y como mucho 24 h; `updatedAt` lo pone el servidor.
      match /days/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['date', 'name', 'level', 'seconds', 'completed', 'lessons', 'updatedAt'])
          && request.resource.data.date == date
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.seconds is number && request.resource.data.seconds <= 86400
          && (resource == null || request.resource.data.seconds >= resource.data.seconds)
          && request.resource.data.completed is bool
          && request.resource.data.lessons is map
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Lecturas leídas: solo el dueño; se marcan con la hora del servidor y se pueden desmarcar.
      match /readings/{lessonId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }

      // Resumen por lección (Mi plan): los contadores solo suben.
      match /lessons/{lessonId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['days', 'attempts', 'lastAt'])
          && request.resource.data.days is int && request.resource.data.attempts is int
          && request.resource.data.lastAt is timestamp
          && (resource == null || (request.resource.data.days >= resource.data.days && request.resource.data.attempts >= resource.data.attempts));
        allow delete: if false;
      }
    }

    // Ranking semanal: consulta de grupo sobre los días de todos (solo lectura, con sesión iniciada).
    match /{path=**}/days/{date} {
      allow read: if signedIn();
    }

    // Ranking precalculado: lo escribe solo una Cloud Function (más adelante); se lee con sesión iniciada.
    match /rankings/{week} {
      allow read: if signedIn();
      allow write: if false;
      match /entries/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
